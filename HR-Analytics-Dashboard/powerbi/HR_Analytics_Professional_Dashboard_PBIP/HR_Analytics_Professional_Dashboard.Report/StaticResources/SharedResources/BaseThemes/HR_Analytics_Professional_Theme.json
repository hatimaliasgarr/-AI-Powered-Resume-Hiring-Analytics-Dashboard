{
  "name": "HR Analytics Professional",
  "dataColors": [
    "#2F80ED",
    "#00A6A6",
    "#F95738",
    "#F2C94C",
    "#2F855A",
    "#7C3AED",
    "#06AED5",
    "#B83280",
    "#6B7280"
  ],
  "background": "#F6F8FB",
  "foreground": "#101828",
  "tableAccent": "#00A6A6",
  "good": "#2F855A",
  "neutral": "#F2C94C",
  "bad": "#F95738",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 16,
      "color": "#102A43"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#667085"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 26,
      "color": "#101828"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "visualHeader": [
          {
            "show": true
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E8EF"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}